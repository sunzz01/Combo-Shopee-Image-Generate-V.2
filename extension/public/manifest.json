{
    "manifest_version": 3,
    "name": "Gimi Shopee X",
    "version": "1.1.1",
    "description": "Shopee Seller Assistant with AI Power",
    "icons": {
        "16": "icon.png",
        "32": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "permissions": [
        "sidePanel",
        "activeTab",
        "tabs",
        "scripting",
        "storage",
        "identity",
        "clipboardWrite"
    ],
    "oauth2": {
        "client_id": "52909362582-bnddaq17icd3vdpn27b2fs7ndjem0pfv.apps.googleusercontent.com",
        "scopes": [
            "openid",
            "https://www.googleapis.com/auth/userinfo.email",
            "https://www.googleapis.com/auth/userinfo.profile"
        ]
    },
    "host_permissions": [
        "<all_urls>",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
    ],
    "optional_host_permissions": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
    ],
    "background": {
        "service_worker": "src/background/index.js",
        "type": "module"
    },
    "side_panel": {
        "default_path": "src/sidepanel/index.html"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.shopee.co.th/*",
                "*://*.shopee.com/*",
                "*://*.shopee.sg/*",
                "*://*.shopee.com.my/*",
                "*://seller.shopee.co.th/*",
                "*://*.lazada.co.th/*",
                "*://*.lazada.com/*",
                "*://*.tiktok.com/*",
                "http://localhost/*",
                "http://127.0.0.1/*",
                "https://*.vercel.app/*"
            ],
            "js": [
                "src/content/index.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_title": "Open Side Panel",
        "default_icon": "icon.png"
    }
}
